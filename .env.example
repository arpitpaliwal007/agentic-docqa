# LLM: any OpenAI-compatible endpoint (Ollama, vLLM, OpenAI, DashScope...)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0

# embeddings (dense via Ollama, sparse BM25 via fastembed)
OLLAMA_HOST=http://localhost:11434
DENSE_MODEL=nomic-embed-text
NOMIC_PREFIXES=true
DENSE_DIM=768
RETRIEVAL_MODE=hybrid

# cross_encoder | llm | none
RERANKER=cross_encoder
RERANK_MODEL=BAAI/bge-reranker-base
# RERANK_DEVICE=cuda  # leave unset for automatic device selection

# leave empty for embedded qdrant
QDRANT_URL=

# LLAMA_CLOUD_API_KEY=
# LANGFUSE_ENABLED=true
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3000
